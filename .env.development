# ============================================================
# Marzban — Local Development Environment
# ============================================================
# Copy this file to .env before starting the server:
#   cp .env.development .env
# ============================================================

# --- Server ---
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# --- Developer flags (enables auto-reload, Swagger, Vite dev server) ---
DEBUG=True
DOCS=True

# --- Database (SQLite, zero-setup) ---
# To use PostgreSQL instead, comment this out and set a postgres:// URL below.
SQLALCHEMY_DATABASE_URL=sqlite:///dev.sqlite3
# SQLALCHEMY_DATABASE_URL=postgresql://marzban:marzban@localhost:5432/marzban_dev

# --- Bootstrap admin (used by: marzban-cli admin import-from-env) ---
# After first import, delete these two lines from .env (keep in .env.development for reference).
SUDO_USERNAME=admin
SUDO_PASSWORD=admin123

# --- JWT ---
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (allow everything in dev) ---
ALLOWED_ORIGINS=*

# --- Xray ---
# Set XRAY_ENABLED=False if you do NOT have the Xray binary installed locally.
# The app will start fully (DB, API, dashboard) but proxy configs won't be activated.
# Set XRAY_ENABLED=True only if xray is installed at XRAY_EXECUTABLE_PATH.
XRAY_ENABLED=False
XRAY_EXECUTABLE_PATH=/usr/local/bin/xray
XRAY_ASSETS_PATH=/usr/local/share/xray
XRAY_JSON=./xray_config.json

# --- Notifications (disabled in dev to avoid noise) ---
TELEGRAM_API_TOKEN=
DISCORD_WEBHOOK_URL=
WEBHOOK_ADDRESS=

NOTIFY_STATUS_CHANGE=False
NOTIFY_USER_CREATED=False
NOTIFY_USER_UPDATED=False
NOTIFY_USER_DELETED=False
NOTIFY_USER_DATA_USED_RESET=False
NOTIFY_USER_SUB_REVOKED=False
NOTIFY_IF_DATA_USAGE_PERCENT_REACHED=False
NOTIFY_IF_DAYS_LEFT_REACHED=False
NOTIFY_LOGIN=False

# --- Subscription ---
XRAY_SUBSCRIPTION_URL_PREFIX=http://127.0.0.1:8000
XRAY_SUBSCRIPTION_PATH=sub

# --- Scheduler (faster polling in dev) ---
JOB_CORE_HEALTH_CHECK_INTERVAL=30
JOB_RECORD_NODE_USAGES_INTERVAL=60
JOB_RECORD_USER_USAGES_INTERVAL=30
JOB_REVIEW_USERS_INTERVAL=30
JOB_SEND_NOTIFICATIONS_INTERVAL=60

# --- Auto-delete (disabled in dev) ---
USERS_AUTODELETE_DAYS=-1
